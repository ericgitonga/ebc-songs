# Optional, cosmetic only: silences dotenv's own promotional "tip" line
# printed on every load (unrelated to Prisma/Supabase).
DOTENV_CONFIG_QUIET="true"

# Preferred: pull from Vercel.
#   vercel env pull .env
#   vercel env pull .env.local
# This pulls the Development-scoped values. Unlike Umoja Voices (two
# separate Supabase projects), EBC Music runs on a SINGLE Supabase project
# split by Postgres schema: Production connects with no `schema` param
# (defaults to `public`); Preview/Development connect with `?schema=preview`
# appended, so both share one database but never touch each other's rows.
# Supabase Auth (auth.users) and Storage buckets are project-wide and are
# NOT split by this — Preview/Dev and Production share the same login users
# and uploaded files.
#
# Fallback (no Vercel project linked): set these two by hand from
# Supabase's Connect dialog (Project -> Connect -> Direct tab). Add
# `?schema=preview` for local/dev work; omit it (or use `?schema=public`)
# for anything meant to touch the production schema. If your database
# password has special characters, percent-encode them first — Supabase's
# own dialog warns about this — or the URL won't parse.
DATABASE_URL="postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true&schema=preview"
DIRECT_URL="postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres?schema=preview"

APP_URL="http://localhost:3000"

# Provisioned by the same Vercel Supabase Marketplace integration as the
# POSTGRES_* vars above — used for Supabase Auth (see src/lib/supabase/).
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY is safe to expose to the browser;
# SUPABASE_SECRET_KEY must never be, and is only read server-side
# (src/lib/supabase/admin.ts) for admin.* operations (invite, role sync,
# forced sign-out, deletion).
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=""
SUPABASE_SECRET_KEY=""

# Only used if Supabase's own SMTP isn't yet configured to use Resend
# (Project Settings -> Auth -> SMTP in the Supabase dashboard) — not read
# by any code path today, kept for any future direct transactional email
# (see src/lib/email.ts, issue #11).
RESEND_API_KEY=""
RESEND_FROM_EMAIL="EBC Music <onboarding@resend.dev>"
